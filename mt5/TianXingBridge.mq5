#property strict
#property version "2.50"
#property description "天行健独立客户端通信EA；保留现有SMC指标"
#include "Json.mqh"
#include "SMCRead.mqh"
input string InpBridgeId="default"; // 客户端通信名称（与客户端设置一致）
input bool InpAllowTrading=false; // 允许客户端确认后的交易指令
input int InpHistoryDays=7; // 成交历史天数
input long InpMagic=2601030; // 客户端新订单Magic
string historyRows="[]";long historyRefreshed=0;double historyNet=0;bool historyTruncated=false;
string root,session;int lockHandle=INVALID_HANDLE;bool busy=false;
bool SafeId(string id){if(StringLen(id)<1||StringLen(id)>64)return false;for(int i=0;i<StringLen(id);i++){ushort c=StringGetCharacter(id,i);if(!((c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='-'||c=='_'))return false;}return true;}
bool WriteJSON(string name,CJAVal &v){string tmp=name+".tmp";int f=FileOpen(tmp,FILE_WRITE|FILE_TXT|FILE_ANSI|FILE_COMMON,0,CP_UTF8);if(f==INVALID_HANDLE)return false;FileWriteString(f,v.Serialize());FileFlush(f);FileClose(f);return FileMove(tmp,FILE_COMMON,name,FILE_COMMON|FILE_REWRITE);}
bool ReadJSON(string name,CJAVal &v){int f=FileOpen(name,FILE_READ|FILE_TXT|FILE_ANSI|FILE_COMMON|FILE_SHARE_READ,0,CP_UTF8);if(f==INVALID_HANDLE)return false;if(FileSize(f)>1024*1024){FileClose(f);return false;}string raw="";while(!FileIsEnding(f))raw+=FileReadString(f)+"\n";FileClose(f);return v.Deserialize(raw,CP_UTF8);}
bool TradingAllowed(){return InpAllowTrading && (bool)TerminalInfoInteger(TERMINAL_CONNECTED)&&(bool)TerminalInfoInteger(TERMINAL_TRADE_ALLOWED)&&(bool)MQLInfoInteger(MQL_TRADE_ALLOWED)&&(bool)AccountInfoInteger(ACCOUNT_TRADE_ALLOWED)&&(bool)AccountInfoInteger(ACCOUNT_TRADE_EXPERT);}
void SymbolRow(string sym,CJAVal &r){MqlTick t;SymbolInfoTick(sym,t);r["symbol"]=sym;r["bid"]=t.bid;r["ask"]=t.ask;r["quote_time"]=(long)t.time;r["digits"]=SymbolInfoInteger(sym,SYMBOL_DIGITS);r["point"]=SymbolInfoDouble(sym,SYMBOL_POINT);r["tick_size"]=SymbolInfoDouble(sym,SYMBOL_TRADE_TICK_SIZE);r["tick_value"]=SymbolInfoDouble(sym,SYMBOL_TRADE_TICK_VALUE);r["tick_value_loss"]=SymbolInfoDouble(sym,SYMBOL_TRADE_TICK_VALUE_LOSS);r["volume_min"]=SymbolInfoDouble(sym,SYMBOL_VOLUME_MIN);r["volume_max"]=SymbolInfoDouble(sym,SYMBOL_VOLUME_MAX);r["volume_step"]=SymbolInfoDouble(sym,SYMBOL_VOLUME_STEP);r["stops_level"]=SymbolInfoInteger(sym,SYMBOL_TRADE_STOPS_LEVEL);r["freeze_level"]=SymbolInfoInteger(sym,SYMBOL_TRADE_FREEZE_LEVEL);r["spread"]=t.ask-t.bid;r["trade_mode"]=SymbolInfoInteger(sym,SYMBOL_TRADE_MODE);}

// Preserve full indicator JSON without rebuilding its thousands of array elements.
// Indicator 1.02 has a stable metadata prefix and footer. The client validates the full JSON.
bool WriteRawJSON(string name,string raw){string tmp=name+".tmp";int f=FileOpen(tmp,FILE_WRITE|FILE_TXT|FILE_ANSI|FILE_COMMON,0,CP_UTF8);if(f==INVALID_HANDLE)return false;FileWriteString(f,raw);FileFlush(f);FileClose(f);return FileMove(tmp,FILE_COMMON,name,FILE_COMMON|FILE_REWRITE);}
bool RelaySnapshot(long chart,CJAVal &row,string &error){
 int f=FileOpen(smcDataPath(chart),FILE_READ|FILE_TXT|FILE_ANSI|FILE_SHARE_READ,0,CP_UTF8);if(f==INVALID_HANDLE){error="SNAPSHOT_NOT_READY";return false;}
 ulong size=FileSize(f);if(size==0||size>32*1024*1024){FileClose(f);error="SNAPSHOT_SIZE_INVALID";return false;}string raw=FileReadString(f);FileClose(f);
 int prefix=StringFind(raw,",\"settings\":"),footer=StringFind(raw,",\"objects_captured_local\":");int len=StringLen(raw);CJAVal head,tail;
 if(prefix<0||footer<0||len<2||StringSubstr(raw,len-1)!="}"||!head.Deserialize(StringSubstr(raw,0,prefix)+"}",CP_UTF8)||!tail.Deserialize("{"+StringSubstr(raw,footer+1),CP_UTF8)){error="SNAPSHOT_SCHEMA_INVALID";return false;}
 if(head["schema"].ToStr()!="txj.smc.snapshot.v1"||head["chart_id"].ToStr()!=IntegerToString(chart)||head["symbol"].ToStr()!=ChartSymbol(chart)||head["timeframe"].ToStr()!=EnumToString(ChartPeriod(chart))||head["snapshot_id"].ToStr()==""||!head.HasKey("analysis_ready",jtBOOL)){error="SNAPSHOT_IDENTITY_MISMATCH";return false;}
 long age=(long)TimeLocal()-tail["published_local"].ToInt(),period=head["period_seconds"].ToInt();if(age<0||age>30||period<=0){error="SNAPSHOT_STALE";return false;}
 long lag=(long)MathMax(TimeCurrent(),TimeTradeServer())-head["as_of"].ToInt();bool stale=!TerminalInfoInteger(TERMINAL_CONNECTED)||lag<0||lag>2*period;
 CJAVal relay;relay["relay_utc"]=(long)TimeGMT();relay["market_evidence_stale"]=stale;relay["terminal_connected"]=(bool)TerminalInfoInteger(TERMINAL_CONNECTED);string extra=relay.Serialize();
 if(!WriteRawJSON(root+"\\snapshots\\"+IntegerToString(chart)+".json",StringSubstr(raw,0,len-1)+","+StringSubstr(extra,1))){error="SNAPSHOT_RELAY_FAILED";return false;}
 row["analysis_ready"].Set(head["analysis_ready"]);row["snapshot_id"].Set(head["snapshot_id"]);row["market_evidence_stale"]=stale;row["as_of"].Set(head["as_of"]);return true;
}
void RefreshHistory(){CJAVal rows;rows.m_type=jtARRAY;
 datetime from=TimeCurrent()-MathMax(1,MathMin(90,InpHistoryDays))*86400;double net=0;int shown=0;
 if(HistorySelect(from,TimeCurrent())){int total=HistoryDealsTotal();for(int i=total-1;i>=0;i--){ulong ticket=HistoryDealGetTicket(i);ENUM_DEAL_TYPE type=(ENUM_DEAL_TYPE)HistoryDealGetInteger(ticket,DEAL_TYPE);if(type!=DEAL_TYPE_BUY&&type!=DEAL_TYPE_SELL)continue;double profit=HistoryDealGetDouble(ticket,DEAL_PROFIT)+HistoryDealGetDouble(ticket,DEAL_SWAP)+HistoryDealGetDouble(ticket,DEAL_COMMISSION)+HistoryDealGetDouble(ticket,DEAL_FEE);net+=profit;if(shown++>=1000)continue;CJAVal r;r["ticket"]=IntegerToString((long)ticket);r["symbol"]=HistoryDealGetString(ticket,DEAL_SYMBOL);r["type"]=EnumToString(type);r["entry"]=EnumToString((ENUM_DEAL_ENTRY)HistoryDealGetInteger(ticket,DEAL_ENTRY));r["volume"]=HistoryDealGetDouble(ticket,DEAL_VOLUME);r["price"]=HistoryDealGetDouble(ticket,DEAL_PRICE);r["profit"]=profit;r["time"]=HistoryDealGetInteger(ticket,DEAL_TIME);r["order"]=IntegerToString((long)HistoryDealGetInteger(ticket,DEAL_ORDER));r["position_id"]=IntegerToString((long)HistoryDealGetInteger(ticket,DEAL_POSITION_ID));r["comment"]=HistoryDealGetString(ticket,DEAL_COMMENT);rows.Add(r);}historyTruncated=shown>1000;}
 historyNet=net;historyRows=rows.Serialize();historyRefreshed=(long)TimeGMT();
}
void Publish(){
 ulong started=GetTickCount64();
 CJAVal s;s["schema"]="txj.client.state.v1";s["bridge_version"]="2.50";s["command_protocol"]="json_multiline_v2";s["terminal_data_path"]=TerminalInfoString(TERMINAL_DATA_PATH);s["session"]=session;s["published_utc"]=(long)TimeGMT();s["server_time"]=(long)TimeCurrent();s["chart_id"]=IntegerToString(ChartID());s["connected"]=(bool)TerminalInfoInteger(TERMINAL_CONNECTED);s["trading_allowed"]=TradingAllowed();s["ea_allows_trading"]=InpAllowTrading;
 s["account"]["login"]=IntegerToString(AccountInfoInteger(ACCOUNT_LOGIN));s["account"]["server"]=AccountInfoString(ACCOUNT_SERVER);s["account"]["currency"]=AccountInfoString(ACCOUNT_CURRENCY);s["account"]["balance"]=AccountInfoDouble(ACCOUNT_BALANCE);s["account"]["equity"]=AccountInfoDouble(ACCOUNT_EQUITY);s["account"]["profit"]=AccountInfoDouble(ACCOUNT_PROFIT);s["account"]["margin"]=AccountInfoDouble(ACCOUNT_MARGIN);s["account"]["margin_free"]=AccountInfoDouble(ACCOUNT_MARGIN_FREE);s["account"]["trade_mode"]=AccountInfoInteger(ACCOUNT_TRADE_MODE);s["account"]["margin_mode"]=AccountInfoInteger(ACCOUNT_MARGIN_MODE);
 s["positions"].m_type=jtARRAY;s["orders"].m_type=jtARRAY;s["deals"].m_type=jtARRAY;s["sources"].m_type=jtARRAY;s["symbols"].m_type=jtARRAY;
 for(int i=0;i<PositionsTotal();i++){ulong ticket=PositionGetTicket(i);if(ticket==0)continue;CJAVal r;r["ticket"]=IntegerToString((long)ticket);r["symbol"]=PositionGetString(POSITION_SYMBOL);r["type"]=EnumToString((ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE));r["volume"]=PositionGetDouble(POSITION_VOLUME);r["price"]=PositionGetDouble(POSITION_PRICE_OPEN);r["current"]=PositionGetDouble(POSITION_PRICE_CURRENT);r["sl"]=PositionGetDouble(POSITION_SL);r["tp"]=PositionGetDouble(POSITION_TP);r["profit"]=PositionGetDouble(POSITION_PROFIT);r["swap"]=PositionGetDouble(POSITION_SWAP);r["magic"]=PositionGetInteger(POSITION_MAGIC);r["identifier"]=IntegerToString(PositionGetInteger(POSITION_IDENTIFIER));r["comment"]=PositionGetString(POSITION_COMMENT);s["positions"].Add(r);}
 for(int i=0;i<OrdersTotal();i++){ulong ticket=OrderGetTicket(i);if(ticket==0)continue;CJAVal r;r["ticket"]=IntegerToString((long)ticket);r["symbol"]=OrderGetString(ORDER_SYMBOL);r["type"]=EnumToString((ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE));r["volume"]=OrderGetDouble(ORDER_VOLUME_CURRENT);r["price"]=OrderGetDouble(ORDER_PRICE_OPEN);r["sl"]=OrderGetDouble(ORDER_SL);r["tp"]=OrderGetDouble(ORDER_TP);r["magic"]=OrderGetInteger(ORDER_MAGIC);r["comment"]=OrderGetString(ORDER_COMMENT);s["orders"].Add(r);}
 if((long)TimeGMT()-historyRefreshed>=15)RefreshHistory();s["history_from"]=(long)(TimeCurrent()-MathMax(1,MathMin(90,InpHistoryDays))*86400);s["history_net"]=historyNet;s["history_truncated"]=historyTruncated;s["history_refreshed_utc"]=historyRefreshed;
 string seen="|";for(long chart=ChartFirst();chart>=0;chart=ChartNext(chart)){string sym=ChartSymbol(chart);if(StringFind(seen,"|"+sym+"|")<0){CJAVal r;SymbolRow(sym,r);s["symbols"].Add(r);seen+=sym+"|";}if(!smcChartHasIndicator(chart))continue;CJAVal row;string error;row["chart_id"]=IntegerToString(chart);row["symbol"]=sym;row["timeframe"]=EnumToString(ChartPeriod(chart));bool ready=RelaySnapshot(chart,row,error);row["bridge_ready"]=ready;if(!ready)row["error"]=error;s["sources"].Add(row);}
 s["published_utc"]=(long)TimeGMT();s["server_time"]=(long)TimeTradeServer();s["publish_duration_ms"]=(long)(GetTickCount64()-started);string raw=s.Serialize();StringReplace(raw,"\"deals\":[]","\"deals\":"+historyRows);WriteRawJSON(root+"\\state.json",raw);
}
ENUM_ORDER_TYPE_FILLING Fill(string sym){long v=SymbolInfoInteger(sym,SYMBOL_FILLING_MODE);if((v&SYMBOL_FILLING_FOK)!=0)return ORDER_FILLING_FOK;if((v&SYMBOL_FILLING_IOC)!=0)return ORDER_FILLING_IOC;return ORDER_FILLING_RETURN;}
bool BuildRequest(CJAVal &c,MqlTradeRequest &r,string &error){
 string action=c["action"].ToStr(),sym=c["args"]["symbol"].ToStr();CJAVal a;a.Set(c["args"]);ZeroMemory(r);r.symbol=sym;r.magic=InpMagic;r.deviation=20;
 if(sym==""||!SymbolSelect(sym,true)){error="品种不存在";return false;}
 ulong ticket=(ulong)StringToInteger(a["ticket"].ToStr());
 if(action=="cancel"||action=="modify_order"){if(!OrderSelect(ticket)||OrderGetString(ORDER_SYMBOL)!=sym){error="挂单不存在或品种已改变";return false;}r.order=ticket;if(action=="cancel"){r.action=TRADE_ACTION_REMOVE;return true;}r.action=TRADE_ACTION_MODIFY;r.price=a["price"].ToDbl();r.sl=a["sl"].ToDbl();r.tp=a["tp"].ToDbl();r.type_time=(ENUM_ORDER_TYPE_TIME)OrderGetInteger(ORDER_TYPE_TIME);r.expiration=(datetime)OrderGetInteger(ORDER_TIME_EXPIRATION);if(r.price<=0||r.sl<=0||r.tp<=0){error="修改挂单必须填写价格、SL、TP";return false;}return true;}
 if(action=="modify_position"||action=="close"){if(!PositionSelectByTicket(ticket)||PositionGetString(POSITION_SYMBOL)!=sym){error="持仓不存在或品种已改变";return false;}r.position=ticket;if(action=="modify_position"){r.action=TRADE_ACTION_SLTP;r.sl=a["sl"].ToDbl();r.tp=a["tp"].ToDbl();if(r.sl<=0||r.tp<=0){error="SL和TP必须大于0";return false;}return true;}r.action=TRADE_ACTION_DEAL;r.type=PositionGetInteger(POSITION_TYPE)==POSITION_TYPE_BUY?ORDER_TYPE_SELL:ORDER_TYPE_BUY;r.volume=PositionGetDouble(POSITION_VOLUME);r.price=SymbolInfoDouble(sym,r.type==ORDER_TYPE_BUY?SYMBOL_ASK:SYMBOL_BID);r.type_filling=Fill(sym);return true;}
 if(action!="place"){error="未知操作";return false;}
 string type=a["type"].ToStr();if(type=="BUY_LIMIT")r.type=ORDER_TYPE_BUY_LIMIT;else if(type=="SELL_LIMIT")r.type=ORDER_TYPE_SELL_LIMIT;else {error="本客户端新计划仅接受BUY_LIMIT或SELL_LIMIT";return false;}
 r.action=TRADE_ACTION_PENDING;r.type_filling=ORDER_FILLING_RETURN;r.type_time=ORDER_TIME_GTC;r.volume=a["volume"].ToDbl();r.price=a["price"].ToDbl();r.sl=a["sl"].ToDbl();r.tp=a["tp"].ToDbl();string tf=a["strategy_timeframe"].ToStr();StringReplace(tf,"PERIOD_","");if(!SafeId(tf)||StringLen(tf)>4)tf="MAN";r.comment="TXJ:"+tf+":"+StringSubstr(c["id"].ToStr(),0,12);
 double step=SymbolInfoDouble(sym,SYMBOL_VOLUME_STEP),tick=SymbolInfoDouble(sym,SYMBOL_TRADE_TICK_SIZE);if(step<=0||tick<=0){error="合约参数缺失";return false;}
 if(r.volume<SymbolInfoDouble(sym,SYMBOL_VOLUME_MIN)||r.volume>SymbolInfoDouble(sym,SYMBOL_VOLUME_MAX)||MathAbs(r.volume/step-MathRound(r.volume/step))>0.000001){error="手数不符合最小值、最大值或步长";return false;}
 double prices[3];prices[0]=r.price;prices[1]=r.sl;prices[2]=r.tp;for(int i=0;i<3;i++)if(prices[i]<=0||!MathIsValidNumber(prices[i])||MathAbs(prices[i]/tick-MathRound(prices[i]/tick))>0.00001){error="价格不符合最小跳动单位";return false;}
 bool buy=r.type==ORDER_TYPE_BUY_LIMIT;double risk=buy?r.price-r.sl:r.sl-r.price,reward=buy?r.tp-r.price:r.price-r.tp;if(risk<=0||reward/risk<1){error="止损方向不正确或RR小于1";return false;}
 MqlTick quote;if(!SymbolInfoTick(sym,quote)||TimeTradeServer()-quote.time>30){error="报价过期";return false;}double maxSpread=a["max_spread"].ToDbl();if(maxSpread<=0||quote.ask-quote.bid>maxSpread){error="点差超出确认上限（价格差）";return false;}if((buy&&r.price>=quote.ask)||(!buy&&r.price<=quote.bid)){error="限价挂单已越过当前报价";return false;}
 double percent=a["risk_percent"].ToDbl();if(percent==0)percent=1;if(!MathIsValidNumber(percent)||percent<1||percent>2){error="单笔风险比例必须在1%至2%之间";return false;}double budget=AccountInfoDouble(ACCOUNT_EQUITY)*percent/100;double cap=MathMin(a["max_loss"].ToDbl(),budget);double loss=0;if(!OrderCalcProfit(buy?ORDER_TYPE_BUY:ORDER_TYPE_SELL,sym,r.volume,r.price,r.sl,loss)||a["max_loss"].ToDbl()<=0||MathAbs(loss)>cap+0.00000001){error="按当前合约计算的止损金额超出确认上限（不含费用与滑点）";return false;}return true;
}
void Execute(string file){
 string fileId=StringSubstr(file,0,StringLen(file)-5);if(!SafeId(fileId)||file!=fileId+".json")return;
 CJAVal saved;if(ReadJSON(root+"\\journal\\"+fileId+".json",saved)){
   if(saved["status"].ToStr()=="processing"){saved["status"]="unconfirmed";saved["message"]="执行日志存在但最终结果缺失；请回查MT5，不自动重发";saved["completed_utc"]=(long)TimeGMT();WriteJSON(root+"\\journal\\"+fileId+".json",saved);}
   WriteJSON(root+"\\outbox\\"+fileId+".json",saved);FileDelete(root+"\\inbox\\"+file,FILE_COMMON);return;
 }
 CJAVal c;if(!ReadJSON(root+"\\inbox\\"+file,c)||c["id"].ToStr()!=fileId){CJAVal bad;bad["id"]=fileId;bad["status"]="rejected";bad["message"]="通信指令JSON读取失败、格式无效或ID不一致；未提交券商";bad["completed_utc"]=(long)TimeGMT();WriteJSON(root+"\\journal\\"+fileId+".json",bad);WriteJSON(root+"\\outbox\\"+fileId+".json",bad);FileDelete(root+"\\inbox\\"+file,FILE_COMMON);return;}string id=c["id"].ToStr();
 CJAVal result;result["id"]=id;result["action"].Set(c["action"]);result["args"].Set(c["args"]);result["account"].Set(c["account"]);result["server"].Set(c["server"]);result["session"].Set(c["session"]);result["status"]="processing";result["completed_utc"]=(long)TimeGMT();if(!WriteJSON(root+"\\journal\\"+id+".json",result))return;
 string error="";long now=(long)TimeGMT();if(c["schema"].ToStr()!="txj.client.command.v1"||c["session"].ToStr()!=session||c["account"].ToStr()!=IntegerToString(AccountInfoInteger(ACCOUNT_LOGIN))||c["server"].ToStr()!=AccountInfoString(ACCOUNT_SERVER))error="账户或EA会话已改变，指令作废";
 else if(c["expires_utc"].ToInt()<now||c["created_utc"].ToInt()>now+3||c["expires_utc"].ToInt()-c["created_utc"].ToInt()>30)error="指令已过期";
 else if(!TradingAllowed())error="终端或EA未允许交易";
 MqlTradeRequest req={};MqlTradeCheckResult check={};MqlTradeResult ret={};
 if(error==""&&!BuildRequest(c,req,error)){};
 if(error==""&&!OrderCheck(req,check)){result["retcode"]=(long)check.retcode;error="交易预检失败: "+check.comment+" ("+IntegerToString(check.retcode)+")";}
 if(error!=""){result["status"]="rejected";result["message"]=error;}
 else {bool sent=OrderSend(req,ret);result["retcode"]=(long)ret.retcode;result["retcode_external"]=(long)ret.retcode_external;result["last_error"]=(long)GetLastError();result["order"]=IntegerToString((long)ret.order);result["deal"]=IntegerToString((long)ret.deal);result["message"]=ret.comment;result["status"]=(sent&&(ret.retcode==TRADE_RETCODE_DONE||ret.retcode==TRADE_RETCODE_PLACED||ret.retcode==TRADE_RETCODE_DONE_PARTIAL))?"accepted":(ret.retcode==TRADE_RETCODE_TIMEOUT||ret.retcode==TRADE_RETCODE_CONNECTION||ret.retcode==0)?"unconfirmed":"rejected";}
 result["completed_utc"]=(long)TimeGMT();WriteJSON(root+"\\outbox\\"+id+".json",result);WriteJSON(root+"\\journal\\"+id+".json",result);FileDelete(root+"\\inbox\\"+file,FILE_COMMON);
}
void OnTimer(){if(busy)return;busy=true;string name;long h=FileFindFirst(root+"\\inbox\\*.json",name,FILE_COMMON);if(h!=INVALID_HANDLE){int count=0;do{Execute(name);count++;}while(count<10&&FileFindNext(h,name));FileFindClose(h);}Publish();busy=false;}
int OnInit(){if(!SafeId(InpBridgeId))return INIT_PARAMETERS_INCORRECT;root="TXJ_Client\\"+InpBridgeId;FolderCreate("TXJ_Client",FILE_COMMON);FolderCreate(root,FILE_COMMON);FolderCreate(root+"\\inbox",FILE_COMMON);FolderCreate(root+"\\outbox",FILE_COMMON);FolderCreate(root+"\\journal",FILE_COMMON);FolderCreate(root+"\\snapshots",FILE_COMMON);lockHandle=FileOpen(root+"\\owner.lock",FILE_READ|FILE_WRITE|FILE_BIN|FILE_COMMON);if(lockHandle==INVALID_HANDLE){Print("同名通信EA已运行，请更换通信名称");return INIT_FAILED;}session=IntegerToString((long)TimeGMT())+"-"+IntegerToString((long)GetTickCount64())+"-"+IntegerToString(ChartID());EventSetTimer(1);Publish();return INIT_SUCCEEDED;}
void OnDeinit(const int reason){EventKillTimer();if(lockHandle!=INVALID_HANDLE){FileClose(lockHandle);FileDelete(root+"\\state.json",FILE_COMMON);}}
